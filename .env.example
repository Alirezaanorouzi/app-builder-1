# Shared
DATABASE_URL=postgresql://appbuilder:appbuilder@127.0.0.1:15432/appbuilder
SESSION_SECRET=change-me-to-a-long-random-string

# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
# First entry in LIARA_MODELS should work with your Liara wallet minimum balance (GET /v1/models).
NEXT_PUBLIC_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017

# Liara — sole LLM provider (OpenAI-compatible: https://developers.liara.ir/ai-chat-completions/)
# Model IDs must match your workspace catalog (GET .../v1/models), e.g. deepseek/deepseek-v4.1-flash
LIARA_API_KEY=your-liara-api-key
# Optional: Liara PaaS CLI token for deploy/scripts (not the AI key above). Or use `liara login`.
# LIARA_CLI_TOKEN=
LIARA_BASE_URL=https://ai.liara.ir/api/YOUR_WORKSPACE_ID/v1
LIARA_MODELS=deepseek/deepseek-v4.1-flash-1017

# Vercel Sandbox (worker only)
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=team_xxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxx
# Optional: golden snapshot (templates/vite-react + npm); see apps/agent/scripts/create_vercel_base_snapshot.py
VERCEL_BASE_SNAPSHOT_ID=
DEPLOY_ENV=dev

# Worker
CONVERSATION_DIR=./data/conversations
WORKER_CONCURRENCY=5
WORKER_WAKE_CONCURRENCY=2
SANDBOX_STACK_WAIT_SECONDS=180
SANDBOX_LOCK_TIMEOUT_SECONDS=300
REMOTE_CONVERSATION_OPEN_TIMEOUT_SECONDS=120
REMOTE_CONVERSATION_ROTATE_AFTER_MESSAGES=12
RUN_STALE_HEARTBEAT_SECONDS=180
WORKER_POLL_SECONDS=1
VERCEL_PREVIEW_WAIT_SECONDS=120
RUN_EVENT_MAX_BYTES=65536
# Cap terminal tool output on the Vercel VM Agent Server (conversation sync size).
OH_MAX_CMD_OUTPUT_CHARS=12000
# local = Vite on your machine; vercel = preview in Vercel Sandbox
SANDBOX_PROVIDER=local
SANDBOX_IDLE_SECONDS=600
SANDBOX_EXTEND_WHEN_REMAINING_SECONDS=300
# Vercel plan cap on total execution_time_limit per sandbox session (Hobby ~2700s).
VERCEL_SANDBOX_MAX_SESSION_SECONDS=2700
# Persistent sandbox: keep only N recent auto-snapshots on session stop (Vercel recommends 1).
VERCEL_SNAPSHOT_RETENTION_COUNT=1
VERCEL_SNAPSHOT_DELETE_EVICTED=1
MAX_ITERATIONS=80
OPENHANDS_SDK_VERSION=1.63.1
# remote = Agent Server on sandbox VM (default when SANDBOX_PROVIDER=vercel); embedded = in-process on worker
AGENT_RUNTIME=auto
AGENT_SERVER_PORT=8000
OH_SECRET_KEY=change-me-agent-server-encryption
OH_SESSION_API_KEYS_0=change-me-session-api-key
# Public HTTPS LLM proxy (required for remote runtime — sandbox cannot use 127.0.0.1)
LLM_PROXY_PUBLIC_URL=https://llm.example.com
LLM_PROXY_ADMIN_URL=https://llm.example.com
LLM_PROXY_ADMIN_KEY=change-me-proxy-admin
RUN_ORPHAN_POLICY=interrupt

# Archives
ARCHIVE_BACKEND=local
ARCHIVE_LOCAL_DIR=./data/archives
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=conversation-archives
S3_REGION=us-east-1