# Copy values into Liara app settings (Web + Worker). Do not commit secrets.

# --- Shared (both apps) ---
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DATABASE
DEPLOY_ENV=prod

# --- Web (Next.js) ---
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://YOUR-WEB.liara.run
NEXT_PUBLIC_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017

# --- Worker ---
LIARA_API_KEY=
LIARA_BASE_URL=https://ai.liara.ir/api/YOUR_WORKSPACE_ID/v1
LIARA_MODELS=deepseek/deepseek-v4.1-flash-1017
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1
SANDBOX_PROVIDER=vercel
SANDBOX_IDLE_SECONDS=600
SANDBOX_EXTEND_WHEN_REMAINING_SECONDS=300
AGENT_RUNTIME=remote
MAX_ITERATIONS=80
OPENHANDS_SDK_VERSION=1.63.1
OH_SECRET_KEY=
OH_SESSION_API_KEYS_0=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_BASE_SNAPSHOT_ID=
VERCEL_PREVIEW_WAIT_SECONDS=120
# Public HTTPS LLM proxy (required unless sandbox uses direct Liara)
LLM_PROXY_PUBLIC_URL=
LLM_PROXY_ADMIN_URL=
LLM_PROXY_ADMIN_KEY=
# Dev-only shortcut — leave unset in production
# LLM_REMOTE_DIRECT_LIARA=0
RUN_ORPHAN_POLICY=interrupt
RUN_EVENT_MAX_BYTES=65536
HEALTH_HTTP_PORT=8080
ARCHIVE_BACKEND=local